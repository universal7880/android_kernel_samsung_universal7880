config FIMC_IS_V5_10_0
	bool "Use fimc-is v5.10.0"
	depends on EXYNOS_FIMC_IS
	select EXYNOS_DEVICE_MIPI_CSIS_VER2 if SOC_EXYNOS7880
	select CSIS_V4_1 if SOC_EXYNOS7880
	select EXYNOS_FIMC_BNS if SOC_EXYNOS7880
	select FIMC_BNS_V4_10_0 if SOC_EXYNOS7880
	select CAMERA_CIS_SELECT if SOC_EXYNOS7880
	select CAMERA_ACT_SELECT if SOC_EXYNOS7880
	select CAMERA_FLASH_SELECT if SOC_EXYNOS7880
	select USE_DIRECT_IS_CONTROL if SOC_EXYNOS7880
	select CAMERA_MC_SCALER_VER2_USE if SOC_EXYNOS7880
	select MC_SCALER_V2_10 if SOC_EXYNOS7880
	select USE_HW_API_COMMON if SOC_EXYNOS7880
	default n
	help
	  fimc-is version 5.10.0
